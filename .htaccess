# Lapisan proteksi tambahan (Apache).
# Document root Laravel yang benar adalah folder /public, bukan root
# proyek ini. File ini HANYA berjaga-jaga: jika suatu saat konfigurasi
# hosting keliru mengarahkan document root ke root proyek (bukan /public),
# maka .git, vendor, storage, dan file konfigurasi tetap tidak bisa diakses
# dari browser. Jika document root sudah benar mengarah ke /public,
# file ini tidak pernah dibaca oleh Apache dan tidak berdampak apa pun.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
